{
  "name": "api-solid",
  "version": "2.0.0",
  "description": "API REST construída com Node.js, Fastify, Prisma e princípios SOLID.",
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "build": "tsup src --out-dir build",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "fastify",
    "prisma",
    "postgresql",
    "solid",
    "clean-architecture",
    "rest-api",
    "vitest",
    "tdd",
    "jwt"
  ],
  "author": "Carlos Ferreira",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prisma/adapter-pg": "7.9.1",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/jwt": "10.2.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "zod": "4.4.3"
  }
}
